# ---------------------------------------------------------------------------
# Football-CLI (Next.js edition)
# Copy this file to .env.local and adjust as needed.
# ---------------------------------------------------------------------------

# Data source ---------------------------------------------------------------
# The Python original scrapes the 2016/17 season. Soccerway rebuilt its site,
# so the Next.js edition reads the exact same pages from the Wayback Machine
# archive, using the same HTML selectors as Football_CLI.py.
#
# Set SOCCERWAY_LIVE=1 to scrape the live site instead (modern Soccerway no
# longer serves the legacy table markup, so archive mode is recommended).
SOCCERWAY_LIVE=0

# Wayback timestamp used when resolving the closest archived snapshot.
SOCCERWAY_ARCHIVE_TIMESTAMP=20170601000000
SOCCERWAY_UCL_ARCHIVE_TIMESTAMP=20161215000000

# Reddit --------------------------------------------------------------------
# Live Streams and Highlights use Reddit's OAuth API. Create a "script" app at
# https://www.reddit.com/prefs/apps and copy the credentials here.
# Without these values the two Reddit features return a setup hint instead of
# failing silently.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Football-CLI/1.1.4 (Next.js edition)
